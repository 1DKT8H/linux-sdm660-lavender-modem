+/*
+ * The generic QMI dispatcher cannot receive 0x23 because older ipa2-lite
+ * advertised an eight-byte server buffer.  Decode 0x23 with the downstream
+ * service description while retaining the existing handshake behaviour.
+ */
+static void ipa_server_message(struct qmi_handle *qmi,
+			       struct sockaddr_qrtr *sq,
+			       const void *data, size_t count)
+{
+	const struct qmi_header *hdr = data;
+	struct qmi_txn txn = { };
+	struct ipa_qmi *ipa_qmi;
+	u16 msg_id;
+
+	if (count < sizeof(*hdr)) {
+		pr_err("ipa2-lite: short IPA QMI message\n");
+		return;
+	}
+	if (le16_to_cpu(hdr->msg_len) > count - sizeof(*hdr)) {
+		pr_err("ipa2-lite: truncated IPA QMI message\n");
+		return;
+	}
+	if (hdr->type != QMI_REQUEST)
+		return;
+
+	ipa_qmi = container_of(qmi, struct ipa_qmi, server_handle);
+	txn.id = le16_to_cpu(hdr->txn_id);
+	msg_id = le16_to_cpu(hdr->msg_id);
+
+	switch (msg_id) {
+	case IPA_QMI_INDICATION_REGISTER:
+		ipa_server_indication_register(qmi, sq, &txn, NULL);
+		break;
+	case IPA_QMI_INSTALL_FILTER_RULE:
+		ipa_server_install_filter(qmi, sq, &txn, data, count);
+		break;
+	case IPA_QMI_FILTER_INSTALLED_NOTIFY:
+		/* The downstream server acknowledges this notification only. */
+		ipa_server_basic_response(qmi, sq, &txn, msg_id,
+					  QMI_RESULT_SUCCESS_V01,
+					  QMI_ERR_NONE_V01);
+		break;
+	default:
+		dev_dbg(ipa_qmi->dev, "unsupported IPA QMI request 0x%x\n", msg_id);
+		ipa_server_basic_response(qmi, sq, &txn, msg_id,
+					  QMI_RESULT_FAILURE_V01,
+					  QMI_ERR_NOT_SUPPORTED_V01);
+		break;
+	}
+}
 
