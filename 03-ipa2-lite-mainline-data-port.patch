+	if (!ipa || ipa->version != 26 || !ipa->empty_rt.size)
+		return -EOPNOTSUPP;
+
+	mutex_lock(&ipa->filter_lock);
+	ret = ipa_filter_update_pointer(ipa, MEM_FT_V4, ipa->empty_rt.addr);
+	if (ret)
+		goto out_unlock;
+	ret = ipa_filter_update_pointer(ipa, MEM_FT_V6, ipa->empty_rt.addr);
+	if (ret)
+		goto out_unlock;
+
+	ipa_filter_replace(ipa, 0, &empty);
+	ipa_filter_replace(ipa, 1, &empty);
+	dev_info(dev, "cleared modem uplink filters\n");
