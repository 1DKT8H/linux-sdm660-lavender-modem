+		 count, v4_count, v6_count);
+	mutex_unlock(&ipa->filter_lock);
+	return 0;
+
+out_free_v6:
+	ipa_dma_free(&v6);
+out_free_v4:
+	ipa_dma_free(&v4);
+out_unlock:
+	mutex_unlock(&ipa->filter_lock);
+	return ret;
+}
