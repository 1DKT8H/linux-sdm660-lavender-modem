+static int ipa_filter_emit_rule(const struct ipa_qmi_filter_rule *rule,
+				u8 **buf, const u8 *end)
+{
+	u32 action, header;
+	int ret;
+
+	switch (rule->action) {
+	case 1: /* QMI_IPA_FILTER_ACTION_SRC_NAT */
+		action = 1; /* IPA_PASS_TO_SRC_NAT */
+		break;
+	case 2: /* QMI_IPA_FILTER_ACTION_DST_NAT */
+		action = 2; /* IPA_PASS_TO_DST_NAT */
+		break;
+	case 3: /* QMI_IPA_FILTER_ACTION_ROUTING */
+		action = 0; /* IPA_PASS_TO_ROUTING */
+		break;
+	case 4: /* QMI_IPA_FILTER_ACTION_EXCEPTION */
+		action = 3; /* IPA_PASS_TO_EXCEPTION */
+		break;
+	default:
+		return -EOPNOTSUPP;
+	}
+
+	if (action != 3 &&
+	    (!rule->route_table_index_valid ||
+	     rule->route_table_index > IPA_QMI_MODEM_ROUTE_MAX))
+		return -EINVAL;
+
+	header = rule->filter_rule.rule_eq_bitmap | (action << 16) |
+		 (rule->route_table_index << 21) | BIT(26); /* retain_hdr */
+	ret = ipa_filter_put_32(buf, end, header);
+	if (ret)
+		return ret;
+
+	return ipa_filter_emit_eq(&rule->filter_rule, buf, end);
+}
+
+static int ipa_filter_build(struct ipa *ipa,
+			    const struct ipa_qmi_filter_rule *rules, u8 count,
+			    u32 ip_type, struct ipa_dma_obj *table, u8 *matched)
+{
+	u8 *buf, *end;
+	u8 i;
+	int ret;
+
+	for (i = 0; i < count; i++)
+		if (rules[i].ip_type == ip_type)
+			(*matched)++;
+
+	if (!*matched)
+		return 0;
+
+	ret = ipa_dma_alloc(ipa, table, IPA_QMI_FILTER_TABLE_SIZE);
+	if (ret)
+		return ret;
+
+	memset(table->virt, 0, table->size);
+	buf = table->virt;
+	end = buf + table->size;
+	for (i = 0; i < count; i++) {
+		if (rules[i].ip_type != ip_type)
+			continue;
+
+		ret = ipa_filter_emit_rule(&rules[i], &buf, end - sizeof(u32));
+		if (ret)
+			goto err_free;
+	}
+
+	ret = ipa_filter_put_32(&buf, end, 0); /* rule-set terminator */
+	if (ret)
+		goto err_free;
+
+	return 0;
+
+err_free:
+	dev_err(ipa->dev, "invalid modem %s filter rule: %d\n",
+		ip_type == 1 ? "IPv4" : "IPv6", ret);
+	ipa_dma_free(table);
+	return ret;
+}
