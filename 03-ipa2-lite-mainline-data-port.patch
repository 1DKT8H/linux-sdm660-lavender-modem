+static void ipa_filter_replace(struct ipa *ipa, unsigned int family,
+			       struct ipa_dma_obj *table)
+{
+	ipa_dma_free(&ipa->modem_filter_prev[family]);
+	ipa->modem_filter_prev[family] = ipa->modem_filter[family];
+	ipa->modem_filter[family] = *table;
+	memset(table, 0, sizeof(*table));
+}
