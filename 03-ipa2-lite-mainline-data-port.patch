+static int ipa_filter_update_pointer(struct ipa *ipa, enum ipa_part_id mem_id,
+				     dma_addr_t table_addr)
+{
+	struct ipa_dma_obj pointer = { }, cmd_args = { };
+	struct fifo_desc desc;
+	union ipa_cmd *cmd;
+	int ret, reserved;
+
+	ret = ipa_dma_alloc(ipa, &pointer, sizeof(u32));
+	if (ret)
+		return ret;
+	put_unaligned_le32(table_addr, pointer.virt);
+
+	ret = ipa_dma_alloc(ipa, &cmd_args, sizeof(*cmd));
+	if (ret)
+		goto free_pointer;
+
+	cmd = cmd_args.virt;
+	cmd->dma_smem.system_addr = pointer.addr;
+	cmd->dma_smem.local_addr = ipa->layout[mem_id].offset + 8 + EP_TX * 4;
+	cmd->dma_smem.size = sizeof(u32);
+	ipa_setup_cmd_desc(&desc, IPA_CMD_DMA_SHARED_MEM, &cmd_args, cmd);
+
+	reserved = ipa_reserve_descs(&ipa->ep[EP_CMD], 1);
+	if (reserved != 1) {
+		ret = -EBUSY;
+		goto free_cmd;
+	}
+
+	ret = ipa_submit_sync(&ipa->ep[EP_CMD], &desc, 1);
+	ipa_release_descs(&ipa->ep[EP_CMD], reserved);
+
+free_cmd:
+	ipa_dma_free(&cmd_args);
+free_pointer:
+	ipa_dma_free(&pointer);
+	return ret;
+}
