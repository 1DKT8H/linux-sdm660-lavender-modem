+	ret = ipa_filter_update_pointer(ipa, MEM_FT_V6,
+					v6_count ? v6.addr : ipa->empty_rt.addr);
+	if (ret)
+		goto out_free_v6;
+	ipa_filter_replace(ipa, 1, &v6);
