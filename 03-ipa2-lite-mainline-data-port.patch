+int ipa_install_modem_filters(struct device *dev,
+			      const struct ipa_qmi_filter_rule *rules, u8 count)
+{
+	struct ipa *ipa = dev_get_drvdata(dev);
+	struct ipa_dma_obj v4 = { }, v6 = { };
+	u8 v4_count = 0, v6_count = 0;
+	int ret;
+
+	if (!ipa || ipa->version != 26 || !ipa->empty_rt.size)
+		return -EOPNOTSUPP;
+	if (count > IPA_QMI_MAX_FILTERS)
+		return -EINVAL;
+	if (!count)
+		return ipa_clear_modem_filters(dev);
+	for (ret = 0; ret < count; ret++)
+		if (rules[ret].ip_type != 1 && rules[ret].ip_type != 2)
+			return -EOPNOTSUPP;
+
+	mutex_lock(&ipa->filter_lock);
+	ret = ipa_filter_build(ipa, rules, count, 1, &v4, &v4_count);
+	if (ret)
+		goto out_unlock;
+	ret = ipa_filter_build(ipa, rules, count, 2, &v6, &v6_count);
+	if (ret)
+		goto out_free_v4;
+
+	ret = ipa_filter_update_pointer(ipa, MEM_FT_V4,
+					v4_count ? v4.addr : ipa->empty_rt.addr);
+	if (ret)
+		goto out_free_v6;
+	ipa_filter_replace(ipa, 0, &v4);
