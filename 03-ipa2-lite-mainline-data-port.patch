+static int ipa_filter_put_8(u8 **buf, const u8 *end, u8 val)
+{
+	if (*buf >= end)
+		return -ENOSPC;
+
+	*(*buf)++ = val;
+	return 0;
+}
+
+static int ipa_filter_put_16(u8 **buf, const u8 *end, u16 val)
+{
+	if (end - *buf < sizeof(val))
+		return -ENOSPC;
+
+	put_unaligned_le16(val, *buf);
+	*buf += sizeof(val);
+	return 0;
+}
+
+static int ipa_filter_put_32(u8 **buf, const u8 *end, u32 val)
+{
+	if (end - *buf < sizeof(val))
+		return -ENOSPC;
+
+	put_unaligned_le32(val, *buf);
+	*buf += sizeof(val);
+	return 0;
+}
+
+static int ipa_filter_pad_32(u8 **buf, const u8 *end)
+{
+	while ((unsigned long)*buf & 3) {
+		if (ipa_filter_put_8(buf, end, 0))
+			return -ENOSPC;
+	}
+
+	return 0;
+}
