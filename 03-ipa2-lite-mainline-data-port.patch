+/*
+ * This is ipa_generate_hw_rule_from_eq() from the downstream IPA v2 driver,
+ * expressed against the QMI-decoded rule rather than its userspace ioctl
+ * wrapper.  The order is hardware ABI and must not be changed.
+ */
+static int ipa_filter_emit_eq(const struct ipa_qmi_filter_data *rule,
+			      u8 **buf, const u8 *end)
+{
+	u8 i;
+	int ret;
+
+	if (rule->num_offset_meq_32 > 2 ||
+	    rule->num_ihl_offset_range_16 > 2 ||
+	    rule->num_ihl_offset_meq_32 > 2 ||
+	    rule->num_offset_meq_128 > 2)
+		return -EINVAL;
+
+#define IPA_FILTER_WRITE(expr) do { ret = (expr); if (ret) return ret; } while (0)
+	if (rule->tos_eq_present) {
+		IPA_FILTER_WRITE(ipa_filter_put_8(buf, end, rule->tos_eq));
+		IPA_FILTER_WRITE(ipa_filter_pad_32(buf, end));
+	}
+
+	if (rule->protocol_eq_present) {
+		IPA_FILTER_WRITE(ipa_filter_put_8(buf, end, rule->protocol_eq));
+		IPA_FILTER_WRITE(ipa_filter_pad_32(buf, end));
+	}
+
+	for (i = 0; i < rule->num_offset_meq_32; i++) {
+		IPA_FILTER_WRITE(ipa_filter_put_8(buf, end,
+					      rule->offset_meq_32[i].offset));
+		IPA_FILTER_WRITE(ipa_filter_put_32(buf, end,
+					       rule->offset_meq_32[i].mask));
+		IPA_FILTER_WRITE(ipa_filter_put_32(buf, end,
+					       rule->offset_meq_32[i].value));
+		IPA_FILTER_WRITE(ipa_filter_pad_32(buf, end));
+	}
+
+	for (i = 0; i < rule->num_ihl_offset_range_16; i++) {
+		IPA_FILTER_WRITE(ipa_filter_put_8(buf, end,
+					      rule->ihl_offset_range_16[i].offset));
+		IPA_FILTER_WRITE(ipa_filter_put_16(buf, end,
+					       rule->ihl_offset_range_16[i].high));
+		IPA_FILTER_WRITE(ipa_filter_put_16(buf, end,
+					       rule->ihl_offset_range_16[i].low));
+		IPA_FILTER_WRITE(ipa_filter_pad_32(buf, end));
+	}
+
+	if (rule->ihl_offset_eq_16_present) {
+		IPA_FILTER_WRITE(ipa_filter_put_8(buf, end,
+					      rule->ihl_offset_eq_16.offset));
+		IPA_FILTER_WRITE(ipa_filter_put_16(buf, end,
+					       rule->ihl_offset_eq_16.value));
+		IPA_FILTER_WRITE(ipa_filter_pad_32(buf, end));
+	}
+
+	if (rule->ihl_offset_eq_32_present) {
+		IPA_FILTER_WRITE(ipa_filter_put_8(buf, end,
+					      rule->ihl_offset_eq_32.offset));
+		IPA_FILTER_WRITE(ipa_filter_put_32(buf, end,
+					       rule->ihl_offset_eq_32.value));
+		IPA_FILTER_WRITE(ipa_filter_pad_32(buf, end));
+	}
+
+	if (rule->num_ihl_offset_meq_32) {
+		IPA_FILTER_WRITE(ipa_filter_put_8(buf, end,
+					      rule->ihl_offset_meq_32[0].offset));
+		IPA_FILTER_WRITE(ipa_filter_put_32(buf, end,
+					       rule->ihl_offset_meq_32[0].mask));
+		IPA_FILTER_WRITE(ipa_filter_put_32(buf, end,
+					       rule->ihl_offset_meq_32[0].value));
+		IPA_FILTER_WRITE(ipa_filter_pad_32(buf, end));
+	}
+
+	for (i = 0; i < rule->num_offset_meq_128; i++) {
+		IPA_FILTER_WRITE(ipa_filter_put_8(buf, end,
+					      rule->offset_meq_128[i].offset));
+		if (end - *buf < 32)
+			return -ENOSPC;
+		memcpy(*buf, rule->offset_meq_128[i].mask, 16);
+		*buf += 16;
+		memcpy(*buf, rule->offset_meq_128[i].value, 16);
+		*buf += 16;
+		IPA_FILTER_WRITE(ipa_filter_pad_32(buf, end));
+	}
+
+	if (rule->tc_eq_present) {
+		IPA_FILTER_WRITE(ipa_filter_put_8(buf, end, rule->tc_eq));
+		IPA_FILTER_WRITE(ipa_filter_pad_32(buf, end));
+	}
+
+	if (rule->flow_eq_present) {
+		IPA_FILTER_WRITE(ipa_filter_put_32(buf, end, rule->flow_eq));
+		IPA_FILTER_WRITE(ipa_filter_pad_32(buf, end));
+	}
+
+	if (rule->num_ihl_offset_meq_32 > 1) {
+		IPA_FILTER_WRITE(ipa_filter_put_8(buf, end,
+					      rule->ihl_offset_meq_32[1].offset));
+		IPA_FILTER_WRITE(ipa_filter_put_32(buf, end,
+					       rule->ihl_offset_meq_32[1].mask));
+		IPA_FILTER_WRITE(ipa_filter_put_32(buf, end,
+					       rule->ihl_offset_meq_32[1].value));
+		IPA_FILTER_WRITE(ipa_filter_pad_32(buf, end));
+	}
+
+	if (rule->metadata_meq32_present) {
+		IPA_FILTER_WRITE(ipa_filter_put_8(buf, end,
+					      rule->metadata_meq32.offset));
+		IPA_FILTER_WRITE(ipa_filter_put_32(buf, end,
+					       rule->metadata_meq32.mask));
+		IPA_FILTER_WRITE(ipa_filter_put_32(buf, end,
+					       rule->metadata_meq32.value));
+		IPA_FILTER_WRITE(ipa_filter_pad_32(buf, end));
+	}
+
+	if (rule->ipv4_frag_eq_present)
+		IPA_FILTER_WRITE(ipa_filter_pad_32(buf, end));
+#undef IPA_FILTER_WRITE
+
+	return 0;
+}
